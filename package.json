{
  "name": "reportes-sg-experimental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-worker.js",
    "predev:local": "node scripts/verify-local-only.mjs",
    "dev:local": "next dev --webpack -p 3010 -H 127.0.0.1",
    "dev:3000": "next dev --webpack -p 3000 -H 127.0.0.1",
    "dev": "npm run dev:local",
    "dev:next": "npm run dev:local",
    "prebuild": "node scripts/verify-local-only.mjs && node scripts/verify-landing-content.mjs && node scripts/verify-landing-env.mjs",
    "build": "next build --webpack",
    "start": "node scripts/serve-out.mjs out 3010",
    "build:pages": "GITHUB_PAGES=true npm run build && node scripts/pages-assemble.mjs",
    "start:pages": "node scripts/serve-out.mjs out-pages 3010 /landing",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:local-only": "node scripts/verify-local-only.mjs",
    "verify:no-firebase": "node scripts/verify-local-only.mjs",
    "verify:roles": "node scripts/verify-role-routes.mjs",
    "verify:all": "npm run verify:local-only && npm run verify:roles"
  },
  "description": "Fork experimental local-only de V2-SG Reports. Sin Firebase.",
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@types/crypto-js": "^4.2.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "emoji-picker-react": "^4.18.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.8.0",
    "framer-motion": "^12.29.0",
    "gsap": "^3.15.0",
    "inherits": "^2.0.4",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.24.0",
    "mkdirp": "^3.0.1",
    "motion": "^12.42.2",
    "next": "16.1.7",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.167.1",
    "vgpu": "^0.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cors": "^2.8.6",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.1",
    "firebase-tools": "^15.4.0",
    "rimraf": "^6.1.2",
    "sharp": "^0.35.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
