import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';

// ============================================================
// 🛡️ Security Middleware — Rate Limiting + Headers + Path Guard
// ============================================================

// ─── Rate Limiting (In-Memory para Edge Runtime) ──────────────
const RATE_LIMIT_WINDOW = 60 * 1000; // 1 minuto
const RATE_LIMIT_MAX = 100;           // 100 requests/minuto por IP

const rateLimitMap = new Map<string, { count: number; resetTime: number }>();

// Limpieza de entradas expiradas
if (typeof setInterval !== 'undefined') {
    setInterval(() => {
        const now = Date.now();
        for (const [key, value] of rateLimitMap) {
            if (now > value.resetTime) rateLimitMap.delete(key);
        }
    }, 5 * 60 * 1000);
}

function checkRateLimit(ip: string): { allowed: boolean; remaining: number } {
    const now = Date.now();
    const entry = rateLimitMap.get(ip);

    if (!entry || now > entry.resetTime) {
        rateLimitMap.set(ip, { count: 1, resetTime: now + RATE_LIMIT_WINDOW });
        return { allowed: true, remaining: RATE_LIMIT_MAX - 1 };
    }

    entry.count++;
    if (entry.count > RATE_LIMIT_MAX) return { allowed: false, remaining: 0 };
    return { allowed: true, remaining: RATE_LIMIT_MAX - entry.count };
}

// ─── Paths Bloqueados (honeypots / scanners comunes) ──────────
const BLOCKED_PATHS = [
    '/wp-admin', '/wp-login', '/wp-content', '/xmlrpc.php',
    '/.env', '/.git', '/phpmyadmin', '/admin.php', '/config.php',
    '/shell', '/cmd', '/eval', '/exec', '/system',
    '/passwd', '/etc/passwd', '/proc/self', '/../',
];

// ─── Patrones de Inyección SQL/NoSQL/XSS ──────────────────────
const INJECTION_PATTERNS = [
    /(\b(SELECT|INSERT|UPDATE|DELETE|DROP|UNION|ALTER|CREATE|EXEC|EXECUTE)\b\s)/i,
    /(\b(OR|AND)\b\s+\d+\s*=\s*\d+)/i,
    /(--|#|\/\*|\*\/)/,
    /(\bSLEEP\s*\()/i,
    /(\bBENCHMARK\s*\()/i,
    /(<script\b[^>]*>)/i,
    /(javascript\s*:)/i,
    /(on\w+\s*=)/i,
    /(\$where|\$gt|\$lt|\$ne|\$regex|\$exists)/i,
];

function hasInjectionAttempt(url: string): boolean {
    const decoded = decodeURIComponent(url);
    return INJECTION_PATTERNS.some(p => p.test(decoded));
}

// ─── Orígenes CORS Permitidos ──────────────────────────────────
const ALLOWED_ORIGINS = [
    'https://simulacros-sg.web.app',
    'https://simulacros-sg.firebaseapp.com',
    'http://localhost:3000',
    'http://localhost:3001',
];

function isAllowedOrigin(origin: string | null): boolean {
    if (!origin) return false;
    return ALLOWED_ORIGINS.includes(origin);
}

// ─── Middleware Principal ──────────────────────────────────────
export function middleware(request: NextRequest) {
    const { pathname } = request.nextUrl;
    const ip =
        request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() ||
        request.headers.get('x-real-ip') ||
        'unknown';
    const origin = request.headers.get('origin');

    // ── 0. Preflight CORS ─────────────────────────────────────
    if (request.method === 'OPTIONS') {
        if (isAllowedOrigin(origin)) {
            return new NextResponse(null, {
                status: 204,
                headers: {
                    'Access-Control-Allow-Origin': origin!,
                    'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
                    'Access-Control-Allow-Headers': 'Content-Type, Authorization, X-Requested-With',
                    'Access-Control-Allow-Credentials': 'true',
                    'Access-Control-Max-Age': '86400',
                },
            });
        }
        return new NextResponse('Forbidden', { status: 403 });
    }

    // ── 1. Bloquear paths maliciosos ──────────────────────────
    const lowerPath = pathname.toLowerCase();
    if (BLOCKED_PATHS.some(blocked => lowerPath.startsWith(blocked))) {
        return new NextResponse('Forbidden', {
            status: 403,
            headers: { 'Content-Type': 'text/plain' },
        });
    }

    // ── 2. Detectar inyección en URL ──────────────────────────
    if (hasInjectionAttempt(request.url)) {
        console.warn(`[Security] Injection blocked from ${ip}: ${request.url}`);
        return new NextResponse('Forbidden', {
            status: 403,
            headers: { 'Content-Type': 'text/plain' },
        });
    }

    // ── 3. Rate Limiting ──────────────────────────────────────
    const { allowed, remaining } = checkRateLimit(ip);
    if (!allowed) {
        console.warn(`[Security] Rate limit exceeded for ${ip}`);
        return new NextResponse('Too Many Requests', {
            status: 429,
            headers: {
                'Content-Type': 'text/plain',
                'Retry-After': '60',
                'X-RateLimit-Limit': String(RATE_LIMIT_MAX),
                'X-RateLimit-Remaining': '0',
            },
        });
    }

    // ── 4. Respuesta con Security Headers + CORS ──────────────
    const response = NextResponse.next();

    // Security Headers
    response.headers.set('X-Frame-Options', 'DENY');
    response.headers.set('X-Content-Type-Options', 'nosniff');
    response.headers.set('X-XSS-Protection', '1; mode=block');
    response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
    response.headers.set('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()');
    response.headers.set('Strict-Transport-Security', 'max-age=63072000; includeSubDomains; preload');
    response.headers.set('X-DNS-Prefetch-Control', 'on');
    response.headers.set('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');

    // CORS headers (solo para orígenes permitidos)
    if (isAllowedOrigin(origin)) {
        response.headers.set('Access-Control-Allow-Origin', origin!);
        response.headers.set('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
        response.headers.set('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With');
        response.headers.set('Access-Control-Allow-Credentials', 'true');
        response.headers.set('Vary', 'Origin');
    }

    // Rate limit info
    response.headers.set('X-RateLimit-Limit', String(RATE_LIMIT_MAX));
    response.headers.set('X-RateLimit-Remaining', String(remaining));

    return response;
}

// Aplica a todas las rutas excepto archivos estáticos de Next.js
export const config = {
    matcher: [
        '/((?!_next/static|_next/image|favicon.ico|icons/|data/|sw.js|manifest.json).*)',
    ],
};
